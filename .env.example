# ── Database ───────────────────────────────────────────────────
# Replace with your actual PostgreSQL credentials
DATABASE_URL=postgresql+asyncpg://postgres:12345@localhost:5432/phps_db

# ── JWT Auth ───────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-new-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AES Encryption (for Jira/Gmail tokens stored in DB) ────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-new-fernet-key

# ── App Settings ───────────────────────────────────────────────
APP_ENV=development
FRONTEND_URL=http://localhost:5173

# Shared secret sent by n8n as the X-N8N-Secret request header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

N8N_WEBHOOK_SECRET=your-generated-random-secret

# Jira Cloud custom field used for story points. Change if your site differs.
JIRA_STORY_POINTS_FIELD=customfield_10016

# â”€â”€ Transactional email (required for new Admin and PM accounts) â”€â”€
# Example: Gmail SMTP with a Google App Password, not your regular password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=projecthealthprediction@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=projecthealthprediction@gmail.com
SMTP_STARTTLS=true

# Development-only: allow account creation when SMTP is unavailable. Keep false in production.
ALLOW_ACCOUNT_CREATION_WITHOUT_EMAIL=false

# â”€â”€ Internal Gmail/Jira scheduler (no n8n required) â”€â”€
# This is the Gmail inbox PHPS monitors. Enable IMAP and use a Google App Password.
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_USERNAME=projecthealthprediction@gmail.com
GMAIL_IMAP_PASSWORD=your-google-app-password
INTERNAL_SCHEDULER_ENABLED=true

# ── FR-13: Agentic Document Assistant (RAG over Confluence + LangGraph) ──
# All KB_* settings default to an offline path (deterministic hashing
# embeddings + a local extractive LLM), so the feature runs with no keys.
# Switch to production providers by setting the values below.

# Retrieval / agent behaviour
KB_TOP_K=6
KB_RELEVANCE_MIN=0.12
KB_MAX_RETRIES=1

# Embeddings: hashing (offline, default) | sentence-transformers
KB_EMBEDDING_PROVIDER=hashing
KB_EMBEDDING_DIM=256
# KB_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM: local (offline extractive) | gemini | anthropic
# Set to "gemini" and provide GEMINI_API_KEY to use Google Gemini in production.
KB_LLM_PROVIDER=gemini
KB_LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your-gemini-api-key
# ANTHROPIC_API_KEY=sk-ant-...   # only if KB_LLM_PROVIDER=anthropic

# Document source: local (seed folder, default) | confluence
KB_DEFAULT_SOURCE=local
# CONFLUENCE_BASE_URL=https://your-org.atlassian.net
# CONFLUENCE_EMAIL=you@your-org.com
# CONFLUENCE_API_TOKEN=your-confluence-api-token
