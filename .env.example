# ── Database ───────────────────────────────────────────────────
# Replace with your actual PostgreSQL credentials
DATABASE_URL=postgresql://phps_user:YourPassword123!@localhost:5432/phps_db

# ── JWT Auth ───────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_YOUR_SECRET_KEY_RUN_COMMAND_ABOVE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AES Encryption (for Jira/Gmail tokens stored in DB) ────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_YOUR_FERNET_KEY_RUN_COMMAND_ABOVE

# ── App Settings ───────────────────────────────────────────────
APP_ENV=development
FRONTEND_URL=http://localhost:5173
